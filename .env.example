# Copy to .env and fill these values. Never commit .env.
TELEGRAM_BOT_TOKEN=<telegram-token>
SERVICE_BOT_TOKEN=<service-telegram-token>
POLZA_API_KEY=<polza-api-key>
RAG_API_TOKEN=<random-internal-token>

POLZA_BASE_URL=https://api.polza.ai/v1
GENERATOR_MODEL=qwen/qwen3.5-9b
EMBED_MODEL=intfloat/multilingual-e5-base
EMBED_BATCH_SIZE=16
EMBED_QUANTIZE=true
EMBED_THREADS=2
INDEX_PARSE_WORKERS=2
INDEX_WORKERS=3
INDEX_ESTIMATED_CHUNKS_PER_SECOND=0.5
INDEX_PUBLISH_PERCENT=5
INDEX_RELOAD_SECONDS=3
INDEX_CPU_LIMIT=1.6
INDEX_MEM_LIMIT=3g
RAG_CPU_LIMIT=1.0
RAG_MEM_LIMIT=3g
LOG_LEVEL=INFO
SERVICE_REPORT_SECONDS=60
TIMEZONE=Europe/Moscow
RAG_CONCURRENCY=2
REQUEST_TIMEOUT=360
HISTORY_TTL=86400

# Paths below are for local Python runs; Compose sets container paths itself.
KB_ZIP=data/raw/MIEM_knowledge_base_unified.zip
FAQ_PATH=data/raw/HSE_Answers_RU.xlsx
INDEX_DIR=data/index
RAG_URL=http://127.0.0.1:8000
REDIS_URL=redis://127.0.0.1:6379/0
LOG_DIR=logs
MONITOR_DIR=data/monitor
